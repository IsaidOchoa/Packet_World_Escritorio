<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="catalogo">

    <select id="obtenerRoles" resultType="pojo.Rol">
        SELECT idRol, nombre FROM Rol
    </select>
    
    <select id="obtenerTiposUnidad" resultType="pojo.TipoUnidad">
        SELECT idTipoUnidad, nombre FROM TipoUnidad
    </select>

    <select id="obtenerEstatusEnvio" resultType="pojo.EstadoEnvio">
        SELECT idEstadoEnvio, nombre FROM EstadoEnvio
    </select>

</mapper>