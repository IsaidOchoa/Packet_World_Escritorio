<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="clienteescritoriopw.FXMLFormularioColaboradorController"
            style="-fx-background-color: #F0F2F5;">

    <top>
        <Label fx:id="lblTitulo"
               text="Registrar Nuevo Colaborador"
               textFill="#1a3b5c"
               BorderPane.alignment="CENTER">
            <font>
                <Font name="System Bold" size="24"/>
            </font>
            <BorderPane.margin>
                <Insets top="20" bottom="20"/>
            </BorderPane.margin>
        </Label>
    </top>

    <center>
        <HBox spacing="30">
            <padding>
                <Insets top="10" left="30" right="30" bottom="10"/>
            </padding>

            <!-- ===== FORMULARIO ===== -->
            <GridPane hgap="10" vgap="10" HBox.hgrow="ALWAYS">
                <columnConstraints>
                    <ColumnConstraints minWidth="140"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <children>
                    <Label text="No. Personal:" GridPane.rowIndex="0"/>
                    <TextField fx:id="tfNoPersonal" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Nombre(s):" GridPane.rowIndex="1"/>
                    <TextField fx:id="tfNombre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="A. Paterno:" GridPane.rowIndex="2"/>
                    <TextField fx:id="tfPaterno" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="A. Materno:" GridPane.rowIndex="3"/>
                    <TextField fx:id="tfMaterno" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="CURP:" GridPane.rowIndex="4"/>
                    <TextField fx:id="tfCurp" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Correo:" GridPane.rowIndex="5"/>
                    <TextField fx:id="tfCorreo" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label text="Password:" GridPane.rowIndex="6"/>
                    <PasswordField fx:id="pfPassword" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                    <Label text="Confirmar Pwd:" GridPane.rowIndex="7"/>
                    <PasswordField fx:id="pfConfirmarPassword" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                    <Label text="Rol:" GridPane.rowIndex="8"/>
                    <ComboBox fx:id="cbRol" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                    <Label text="Sucursal:" GridPane.rowIndex="9"/>
                    <ComboBox fx:id="cbSucursal" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

                    <Label text="Licencia:" GridPane.rowIndex="10"/>
                    <TextField fx:id="tfLicencia" GridPane.rowIndex="10" GridPane.columnIndex="1"/>
                </children>
            </GridPane>

            <!-- ===== FOTO ===== -->
            <VBox spacing="10" alignment="TOP_CENTER">
                <Label text="Fotografía"/>
                <ImageView fx:id="ivFoto"
                           fitWidth="180"
                           fitHeight="180"
                           preserveRatio="true"
                           style="-fx-border-color: #999; -fx-border-width: 1;"/>
                <Button text="Seleccionar Foto"
                        onAction="#clicSeleccionarFoto"/>
            </VBox>

        </HBox>
    </center>

    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="20" right="30" bottom="20"/>
            </padding>

            <Button text="Aceptar"
                    prefWidth="120"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white;"
                    onAction="#clicAceptar"/>

            <Button text="Cancelar"
                    prefWidth="120"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;"
                    onAction="#clicCancelar"/>
        </HBox>
    </bottom>

</BorderPane>
