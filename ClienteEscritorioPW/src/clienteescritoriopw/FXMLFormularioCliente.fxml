<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="clienteescritoriopw.FXMLFormularioClienteController">
   <children>
      <Pane prefHeight="60.0" prefWidth="700.0" style="-fx-background-color: #1A3B5C;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label fx:id="lbTitulo" layoutX="24.0" layoutY="13.0" text="Registro de Cliente" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </Pane>

      <Label layoutX="30.0" layoutY="80.0" text="Datos Personales" textFill="#1a3b5c">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      
      <TextField fx:id="tfNombre" layoutX="30.0" layoutY="115.0" prefHeight="30.0" prefWidth="200.0" promptText="Nombre(s)" />
      <TextField fx:id="tfPaterno" layoutX="250.0" layoutY="115.0" prefHeight="30.0" prefWidth="200.0" promptText="Apellido Paterno" />
      <TextField fx:id="tfMaterno" layoutX="470.0" layoutY="115.0" prefHeight="30.0" prefWidth="200.0" promptText="Apellido Materno" />
      
      <TextField fx:id="tfTelefono" layoutX="30.0" layoutY="165.0" prefHeight="30.0" prefWidth="200.0" promptText="Teléfono (10 dígitos)" />
      <TextField fx:id="tfCorreo" layoutX="250.0" layoutY="165.0" prefHeight="30.0" prefWidth="420.0" promptText="Correo Electrónico" />

      <Label layoutX="30.0" layoutY="215.0" text="Dirección" textFill="#1a3b5c">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>

      <ComboBox fx:id="cbEstado" layoutX="30.0" layoutY="250.0" prefHeight="30.0" prefWidth="200.0" promptText="Selecciona Estado..." />
      <ComboBox fx:id="cbMunicipio" layoutX="250.0" layoutY="250.0" prefHeight="30.0" prefWidth="200.0" promptText="Selecciona Municipio..." />
      <TextField fx:id="tfCodigoPostal" onAction="#clicBuscarCP" layoutX="430.0" layoutY="250.0" prefHeight="30.0" prefWidth="80.0" promptText="C.P." />
      
      <Button layoutX="520.0" layoutY="250.0" mnemonicParsing="false" onAction="#clicBuscarCP" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #555;" text="Buscar" textFill="WHITE">
          <font>
              <Font name="System Bold" size="12.0" />
          </font>
      </Button>
      <ComboBox fx:id="cbColonia" layoutX="30.0" layoutY="300.0" prefHeight="30.0" prefWidth="200.0" promptText="Selecciona Colonia..." />
      <TextField fx:id="tfCalle" layoutX="250.0" layoutY="300.0" prefHeight="30.0" prefWidth="300.0" promptText="Calle" />
      <TextField fx:id="tfNumero" layoutX="570.0" layoutY="300.0" prefHeight="30.0" prefWidth="100.0" promptText="Número" />

      <Button layoutX="230.0" layoutY="420.0" mnemonicParsing="false" onAction="#clicGuardar" prefHeight="40.0" prefWidth="110.0" style="-fx-background-color: #2ecc71;" text="Guardar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      <Button layoutX="360.0" layoutY="420.0" mnemonicParsing="false" onAction="#clicCancelar" prefHeight="40.0" prefWidth="110.0" style="-fx-background-color: #e74c3c;" text="Cancelar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
