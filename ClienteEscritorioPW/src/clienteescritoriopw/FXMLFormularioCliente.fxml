<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="clienteescritoriopw.FXMLFormularioClienteController">
   <children>
      <Pane prefHeight="60.0" style="-fx-background-color: #1A3B5C;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label fx:id="lbTitulo" layoutX="24.0" layoutY="13.0" text="Registro de Cliente" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </Pane>

      <VBox spacing="15.0" AnchorPane.bottomAnchor="80.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="80.0">
         <children>
            
            <Label text="Datos Personales" textFill="#1a3b5c">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            
            <HBox spacing="15.0">
               <children>
                  <TextField fx:id="tfNombre" prefHeight="30.0" promptText="Nombre(s)" HBox.hgrow="ALWAYS" />
                  <TextField fx:id="tfPaterno" prefHeight="30.0" promptText="Apellido Paterno" HBox.hgrow="ALWAYS" />
                  <TextField fx:id="tfMaterno" prefHeight="30.0" promptText="Apellido Materno" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            
            <HBox spacing="15.0">
               <children>
                  <TextField fx:id="tfTelefono" prefHeight="30.0" prefWidth="200.0" promptText="Teléfono (10 dígitos)" />
                  <TextField fx:id="tfCorreo" prefHeight="30.0" promptText="Correo Electrónico" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <Label text="Dirección" textFill="#1a3b5c">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Label>

            <HBox spacing="15.0" alignment="CENTER_LEFT">
               <children>
                  <ComboBox fx:id="cbEstado" prefHeight="30.0" prefWidth="180.0" promptText="Selecciona Estado..." />
                  <ComboBox fx:id="cbMunicipio" prefHeight="30.0" prefWidth="180.0" promptText="Selecciona Municipio..." />
                  
                  <Pane HBox.hgrow="ALWAYS" /> 
                  
                  <TextField fx:id="tfCodigoPostal" onAction="#clicBuscarCP" prefHeight="30.0" prefWidth="80.0" promptText="C.P." />
                  <Button mnemonicParsing="false" onAction="#clicBuscarCP" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #555;" text="Buscar" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Button>
               </children>
            </HBox>

            <HBox spacing="15.0">
               <children>
                  <ComboBox fx:id="cbColonia" prefHeight="30.0" prefWidth="250.0" promptText="Selecciona Colonia..." />
                  <TextField fx:id="tfCalle" prefHeight="30.0" promptText="Calle" HBox.hgrow="ALWAYS" />
                  <TextField fx:id="tfNumero" prefHeight="30.0" prefWidth="100.0" promptText="Número" />
               </children>
            </HBox>
         </children>
      </VBox>

      <HBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <Button mnemonicParsing="false" onAction="#clicGuardar" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #2ecc71;" text="Guardar" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Button mnemonicParsing="false" onAction="#clicCancelar" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #e74c3c;" text="Cancelar" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
</AnchorPane>