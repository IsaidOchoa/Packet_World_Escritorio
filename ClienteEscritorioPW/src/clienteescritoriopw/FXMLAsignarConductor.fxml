<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="300.0" prefWidth="450.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="clienteescritoriopw.FXMLAsignarConductorController">
   <children>
      <Pane prefHeight="60.0" prefWidth="450.0" style="-fx-background-color: #1A3B5C;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label layoutX="24.0" layoutY="13.0" text="Asignación de Conductor" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
         </children>
      </Pane>
      
      <Label fx:id="lbUnidad" layoutX="40.0" layoutY="85.0" text="Unidad: Nissan Versa (2023)" textFill="#1a3b5c">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      
      <Label layoutX="40.0" layoutY="130.0" text="Selecciona un conductor:" textFill="#555555">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      
      <ComboBox fx:id="cbConductores" layoutX="40.0" layoutY="160.0" prefHeight="35.0" prefWidth="370.0" promptText="-- Seleccionar Conductor --" />
      
      <Button layoutX="40.0" layoutY="230.0" mnemonicParsing="false" onAction="#clicGuardar" prefHeight="35.0" prefWidth="110.0" style="-fx-background-color: #2ecc71;" text="Asignar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      
      <Button layoutX="170.0" layoutY="230.0" mnemonicParsing="false" onAction="#clicDesasignar" prefHeight="35.0" prefWidth="110.0" style="-fx-background-color: #f39c12;" text="Desasignar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      
      <Button layoutX="300.0" layoutY="230.0" mnemonicParsing="false" onAction="#clicCancelar" prefHeight="35.0" prefWidth="110.0" style="-fx-background-color: #e74c3c;" text="Cancelar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
